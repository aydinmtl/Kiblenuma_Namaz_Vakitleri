<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvPlace"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:paddingVertical="6dp"
                android:textColor="@color/text"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Konumu ve vakitleri yenile (widget'taki ↻ ile aynı iş) -->
            <ImageButton
                android:id="@+id/btnRefresh"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Konumu ve vakitleri yenile"
                android:src="@drawable/ic_refresh" />

            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Ayarlar"
                android:src="@drawable/ic_settings" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvLocMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/gold"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/muted"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvHijri"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/muted"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvNextLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/muted"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvCountdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:text="--:--:--"
                android:textColor="@color/gold"
                android:textSize="48sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:padding="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnImsakiye"
                style="@style/Btn"
                android:layout_width="0dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="@string/imsakiye" />

            <Button
                android:id="@+id/btnQibla"
                style="@style/Btn"
                android:layout_width="0dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="@string/qibla" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnMosques"
                style="@style/Btn"
                android:layout_width="0dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="Camiler" />

            <Button
                android:id="@+id/btnHolyDays"
                style="@style/Btn"
                android:layout_width="0dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="Dini Günler" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnKaza"
                style="@style/Btn"
                android:layout_width="0dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="Kaza Çetelesi" />

            <Button
                android:id="@+id/btnZikir"
                style="@style/Btn"
                android:layout_width="0dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="Zikirmatik" />
        </LinearLayout>

        <Button
            android:id="@+id/btnQuiz"
            style="@style/Btn"
            android:layout_width="match_parent"
            android:layout_marginTop="12dp"
            android:text="🌳  Aile Halkası · Bilgi Yarışması" />

        <!-- Çocuklar için: soruları bildikçe abdest alıp namaz kılan figür -->
        <Button
            android:id="@+id/btnPrayerGame"
            style="@style/Btn"
            android:layout_width="match_parent"
            android:layout_marginTop="12dp"
            android:text="🕌  Namaz Öğreniyorum · Çocuklar için oyun" />

        <!-- Kodla üretilmiş 3B canlandırma: namazın hareketleri sırayla -->
        <Button
            android:id="@+id/btnNamaz3d"
            style="@style/Btn"
            android:layout_width="match_parent"
            android:layout_marginTop="12dp"
            android:text="🎬  Namazı 3B izle" />

        <!-- Aile Halkası: her gün bir soru -->
        <Button
            android:id="@+id/btnDaily"
            style="@style/Btn"
            android:layout_width="match_parent"
            android:layout_marginTop="12dp"
            android:text="💡  Günün sorusu" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="@color/muted"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
