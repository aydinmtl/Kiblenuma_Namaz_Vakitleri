<?xml version="1.0" encoding="utf-8"?>
<!-- Namaz Öğreniyorum: çocuklar için abdest ve namaz oyunu (PrayerGameActivity) -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Üst satır: geri, başlık, sesli okuma -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="Geri"
                android:paddingTop="2dp"
                android:paddingEnd="14dp"
                android:paddingBottom="2dp"
                android:text="‹"
                android:textColor="@color/gold"
                android:textSize="34sp" />

            <TextView
                style="@style/Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Namaz Öğreniyorum" />

            <TextView
                android:id="@+id/btnSpeak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="Sesli oku"
                android:padding="8dp"
                android:text="🔊 Oku"
                android:textColor="@color/gold"
                android:textSize="15sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- ================= BAŞLANGIÇ: figür seçimi ================= -->
        <LinearLayout
            android:id="@+id/startPane"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Soruları bildikçe arkadaşın abdest alıp namaz kılacak. Bakalım sabah namazını sonuna kadar kıldırabilecek misin?"
                android:textColor="@color/muted"
                android:textSize="15sp" />

            <TextView
                style="@style/SectionHead"
                android:text="Kimle oynamak istersin?" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/cardBoy"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/char_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <!-- 3B figürün kodla üretilmiş görüntüsü -->
                    <ImageView
                        android:id="@+id/previewBoy"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:adjustViewBounds="true"
                        android:importantForAccessibility="no"
                        android:src="@drawable/namaz_ahmet" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Ahmet"
                        android:textColor="@color/text"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cardGirl"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/char_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <!-- 3B figürün kodla üretilmiş görüntüsü -->
                    <ImageView
                        android:id="@+id/previewGirl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:adjustViewBounds="true"
                        android:importantForAccessibility="no"
                        android:src="@drawable/namaz_zeynep" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Zeynep"
                        android:textColor="@color/text"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/btnStart"
                style="@style/Btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:minHeight="58dp"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnNamazOnly"
                style="@style/Btn"
                android:layout_width="match_parent"
                android:layout_marginTop="10dp"
                android:text="🕌  Abdesti biliyorum, namazdan başla" />

            <TextView
                android:id="@+id/btnRestart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:background="?android:attr/selectableItemBackground"
                android:padding="10dp"
                android:text="Baştan başla"
                android:textColor="@color/muted"
                android:textSize="15sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvWins"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textColor="@color/gold"
                android:textSize="15sp"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Abdest ve sabah namazının farzı (2 rekat) Hanefi mezhebine göre anlatılır. Kaynağı olan adımlarda ayet ya da hadis numarası verilmiştir."
                android:textColor="@color/muted"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- ================= OYUN ================= -->
        <LinearLayout
            android:id="@+id/gamePane"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvChapter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/muted"
                android:textSize="14sp" />

            <ProgressBar
                android:id="@+id/bar"
                style="@android:style/Widget.Material.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:progressTint="@color/gold" />

            <com.aydinmtl.namazvakitleri.PrayerStageView
                android:id="@+id/figure"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:contentDescription="Abdest alan ve namaz kılan çocuk" />

            <!-- Doğru cevaptan sonra: "Adım 5 · Yüzümüzü yıkıyoruz" -->
            <TextView
                android:id="@+id/tvStepTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:textColor="@color/gold"
                android:textSize="19sp"
                android:textStyle="bold"
                android:visibility="invisible" />

            <!-- Figür bir dua ya da sure okurken: okunuş kelime kelime altın renge döner, altında anlamı.
                 Dokununca okuma hemen biter. -->
            <TextView
                android:id="@+id/tvRecite"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/level_card"
                android:lineSpacingExtra="4dp"
                android:padding="14dp"
                android:textColor="@color/text"
                android:textSize="18sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/questionBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvQuestion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/card"
                    android:lineSpacingExtra="4dp"
                    android:padding="16dp"
                    android:textColor="@color/text"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/options"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/tvInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:accessibilityLiveRegion="polite"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/text"
                    android:textSize="15sp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnNext"
                    style="@style/Btn"
                    android:layout_width="match_parent"
                    android:layout_marginTop="12dp"
                    android:text="Devam ›"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Namaz tamamlanınca -->
            <LinearLayout
                android:id="@+id/finishBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:importantForAccessibility="no"
                    android:text="🏆"
                    android:textSize="56sp" />

                <TextView
                    android:id="@+id/tvFinishTitle"
                    style="@style/Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/tvFinishText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/text"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/btnAgain"
                    style="@style/Btn"
                    android:layout_width="match_parent"
                    android:layout_marginTop="16dp"
                    android:text="🔁  Tekrar oyna" />

                <TextView
                    android:id="@+id/btnExit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:padding="10dp"
                    android:text="Çıkış"
                    android:textColor="@color/muted"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
