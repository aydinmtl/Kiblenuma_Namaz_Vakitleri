<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            style="@style/Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ayarlar" />

        <!-- ============ KONUM ============ -->
        <TextView style="@style/SectionHead" android:text="Konum" />

        <LinearLayout style="@style/SectionCard">

            <TextView
                android:id="@+id/tvCurrentPlace"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <Switch
                android:id="@+id/swAuto"
                style="@style/SettingSwitch"
                android:text="Otomatik konum" />

            <TextView
                android:id="@+id/tvAutoInfo"
                style="@style/SettingNote"
                android:text="Seyahat ettiğinde bulunduğun şehri bulur; vakitleri ve ekrandaki şehir/ülke adını ona göre değiştirir. Konum, uygulamayı açtığında kontrol edilir ve yalnızca şehir adını bulmak için kullanılır; hiçbir sunucuya kaydedilmez." />

            <Button
                android:id="@+id/btnManual"
                style="@style/Btn"
                android:layout_width="match_parent"
                android:layout_marginTop="12dp"
                android:text="Şehri elle seç" />

            <TextView
                style="@style/SettingNote"
                android:text="Elle seçim yaparsan otomatik konum kapanır." />
        </LinearLayout>

        <!-- ============ VAKİT HESAPLAMA ============ -->
        <TextView style="@style/SectionHead" android:text="Vakit hesaplama" />

        <LinearLayout style="@style/SectionCard">

            <TextView
                android:id="@+id/rowMethod"
                style="@style/SettingRow" />

            <TextView
                android:id="@+id/tvMethodInfo"
                style="@style/SettingNote" />

            <TextView
                android:id="@+id/rowAsr"
                style="@style/SettingRow"
                android:layout_marginTop="10dp" />

            <TextView
                style="@style/SettingNote"
                android:text="Standart: Şafii, Maliki, Hanbeli mezhepleri ve Diyanet. Hanefi: asr-ı sani (gölge boyun iki katı). Diyanet seçiliyken Diyanet'in resmi vakti kullanılır." />
        </LinearLayout>

        <!-- ============ BİLDİRİMLER ============ -->
        <TextView style="@style/SectionHead" android:text="Bildirimler" />

        <LinearLayout
            android:id="@+id/notifyCard"
            style="@style/SectionCard">

            <Switch
                android:id="@+id/swNotify"
                style="@style/SettingSwitch"
                android:layout_marginTop="0dp"
                android:text="Vakit bildirimleri" />

            <TextView
                style="@style/SettingNote"
                android:text="Hangi vakitlerde bildirim gelsin?" />

            <LinearLayout
                android:id="@+id/prayerChecks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/rowReminder"
                style="@style/SettingRow"
                android:layout_marginTop="10dp" />

            <Button
                android:id="@+id/btnSound"
                style="@style/Btn"
                android:layout_width="match_parent"
                android:layout_marginTop="12dp"
                android:text="Bildirim sesini değiştir" />

            <!-- Ezan sesi -->
            <Switch
                android:id="@+id/swAdhan"
                style="@style/SettingSwitch"
                android:layout_marginTop="16dp"
                android:text="Vakit girince ezan sesi çal" />

            <TextView
                android:id="@+id/tvAdhanFile"
                style="@style/SettingNote" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnPickAdhan"
                    style="@style/Btn"
                    android:layout_width="0dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="Ses dosyası seç" />

                <Button
                    android:id="@+id/btnTestAdhan"
                    style="@style/Btn"
                    android:layout_width="0dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="Dinle" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/cbSilent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Telefon sessiz ya da titreşimdeyken ezan çalma"
                android:textColor="@color/text" />

            <TextView
                android:id="@+id/tvPermissions"
                style="@style/SettingNote"
                android:textColor="@color/gold" />
        </LinearLayout>

        <!-- ============ VAKİTLER ============ -->
        <TextView style="@style/SectionHead" android:text="Vakitler" />

        <LinearLayout style="@style/SectionCard">

            <TextView
                android:id="@+id/tvData"
                style="@style/SettingNote"
                android:layout_marginTop="0dp" />

            <Button
                android:id="@+id/btnRefresh"
                style="@style/Btn"
                android:layout_width="match_parent"
                android:layout_marginTop="12dp"
                android:text="Vakitleri şimdi güncelle" />
        </LinearLayout>

        <!-- ============ HAKKINDA ============ -->
        <TextView style="@style/SectionHead" android:text="Hakkında" />

        <LinearLayout style="@style/SectionCard">

            <TextView
                android:id="@+id/tvAbout"
                style="@style/SettingNote"
                android:layout_marginTop="0dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
