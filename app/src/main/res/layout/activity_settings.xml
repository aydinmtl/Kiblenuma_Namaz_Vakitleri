<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            style="@style/Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/set_title" />

        <!-- ============ KONUM ============ -->
        <TextView style="@style/SectionHead" android:text="@string/set_sec_location" />

        <LinearLayout style="@style/SectionCard">

            <TextView
                android:id="@+id/tvCurrentPlace"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <Switch
                android:id="@+id/swAuto"
                style="@style/SettingSwitch"
                android:text="@string/set_auto_location" />

            <TextView
                android:id="@+id/tvAutoInfo"
                style="@style/SettingNote"
                android:text="@string/set_auto_location_note" />

            <Button
                android:id="@+id/btnManual"
                style="@style/Btn"
                android:layout_width="match_parent"
                android:layout_marginTop="12dp"
                android:text="@string/set_manual" />

            <TextView
                style="@style/SettingNote"
                android:text="@string/set_manual_note" />
        </LinearLayout>

        <!-- ============ VAKİT HESAPLAMA ============ -->
        <TextView style="@style/SectionHead" android:text="@string/set_sec_calc" />

        <LinearLayout style="@style/SectionCard">

            <TextView
                android:id="@+id/rowMethod"
                style="@style/SettingRow" />

            <TextView
                android:id="@+id/tvMethodInfo"
                style="@style/SettingNote" />

            <TextView
                android:id="@+id/rowAsr"
                style="@style/SettingRow"
                android:layout_marginTop="10dp" />

            <TextView
                style="@style/SettingNote"
                android:text="@string/set_asr_note" />
        </LinearLayout>

        <!-- ============ BİLDİRİMLER ============ -->
        <TextView style="@style/SectionHead" android:text="@string/set_sec_notif" />

        <LinearLayout
            android:id="@+id/notifyCard"
            style="@style/SectionCard">

            <Switch
                android:id="@+id/swNotify"
                style="@style/SettingSwitch"
                android:layout_marginTop="0dp"
                android:text="@string/set_notify" />

            <TextView
                style="@style/SettingNote"
                android:text="@string/set_which" />

            <LinearLayout
                android:id="@+id/prayerChecks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/rowReminder"
                style="@style/SettingRow"
                android:layout_marginTop="10dp" />

            <Button
                android:id="@+id/btnSound"
                style="@style/Btn"
                android:layout_width="match_parent"
                android:layout_marginTop="12dp"
                android:text="@string/set_sound" />

            <!-- Ezan sesi -->
            <Switch
                android:id="@+id/swAdhan"
                style="@style/SettingSwitch"
                android:layout_marginTop="16dp"
                android:text="@string/set_adhan" />

            <TextView
                android:id="@+id/tvAdhanFile"
                style="@style/SettingNote" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnPickAdhan"
                    style="@style/Btn"
                    android:layout_width="0dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="@string/set_adhan_pick" />

                <Button
                    android:id="@+id/btnTestAdhan"
                    style="@style/Btn"
                    android:layout_width="0dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="@string/listen" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/cbSilent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/set_adhan_silent"
                android:textColor="@color/text" />

            <TextView
                android:id="@+id/tvPermissions"
                style="@style/SettingNote"
                android:textColor="@color/gold" />
        </LinearLayout>

        <!-- ============ VAKİTLER ============ -->
        <TextView style="@style/SectionHead" android:text="@string/set_sec_times" />

        <LinearLayout style="@style/SectionCard">

            <TextView
                android:id="@+id/tvData"
                style="@style/SettingNote"
                android:layout_marginTop="0dp" />

            <Button
                android:id="@+id/btnRefresh"
                style="@style/Btn"
                android:layout_width="match_parent"
                android:layout_marginTop="12dp"
                android:text="@string/set_refresh_now" />
        </LinearLayout>

        <!-- ============ HAKKINDA ============ -->
        <TextView style="@style/SectionHead" android:text="@string/set_sec_about" />

        <LinearLayout style="@style/SectionCard">

            <TextView
                android:id="@+id/tvAbout"
                style="@style/SettingNote"
                android:layout_marginTop="0dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
