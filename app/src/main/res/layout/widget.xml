<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_next"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:textColor="@color/gold"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Chronometer
            android:id="@+id/w_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Yenile: konumu bulur ve vakitleri günceller -->
        <ImageView
            android:id="@+id/w_refresh"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:contentDescription="Konumu ve vakitleri yenile"
            android:padding="6dp"
            android:src="@drawable/ic_refresh" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_place"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textColor="@color/muted"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <LinearLayout android:id="@+id/w_c0" style="@style/WCol">
            <TextView android:id="@+id/w_n0" style="@style/WName" android:text="İmsak" />
            <TextView android:id="@+id/w_t0" style="@style/WTime" />
        </LinearLayout>
        <LinearLayout android:id="@+id/w_c1" style="@style/WCol">
            <TextView android:id="@+id/w_n1" style="@style/WName" android:text="Güneş" />
            <TextView android:id="@+id/w_t1" style="@style/WTime" />
        </LinearLayout>
        <LinearLayout android:id="@+id/w_c2" style="@style/WCol">
            <TextView android:id="@+id/w_n2" style="@style/WName" android:text="Öğle" />
            <TextView android:id="@+id/w_t2" style="@style/WTime" />
        </LinearLayout>
        <LinearLayout android:id="@+id/w_c3" style="@style/WCol">
            <TextView android:id="@+id/w_n3" style="@style/WName" android:text="İkindi" />
            <TextView android:id="@+id/w_t3" style="@style/WTime" />
        </LinearLayout>
        <LinearLayout android:id="@+id/w_c4" style="@style/WCol">
            <TextView android:id="@+id/w_n4" style="@style/WName" android:text="Akşam" />
            <TextView android:id="@+id/w_t4" style="@style/WTime" />
        </LinearLayout>
        <LinearLayout android:id="@+id/w_c5" style="@style/WCol">
            <TextView android:id="@+id/w_n5" style="@style/WName" android:text="Yatsı" />
            <TextView android:id="@+id/w_t5" style="@style/WTime" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
