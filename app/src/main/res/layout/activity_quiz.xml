<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- ================= ANA SAYFA: ağaç, seviyeler, hedefler ================= -->
        <LinearLayout
            android:id="@+id/homePane"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                style="@style/Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Aile Halkası" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Birlikte bilgi yarışması. İlk kez doğru bilinen her soru aile ağacımızı büyütür."
                android:textColor="@color/muted"
                android:textSize="14sp" />

            <com.aydinmtl.namazvakitleri.TreeView
                android:id="@+id/tree"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/card" />

            <TextView
                android:id="@+id/tvTree"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textColor="@color/gold"
                android:textSize="15sp" />

            <!-- Her gün bir soru -->
            <Button
                android:id="@+id/btnDailyHome"
                style="@style/Btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="52dp"
                android:text="💡 Günün sorusu" />

            <CheckBox
                android:id="@+id/cbDaily"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:buttonTint="@color/gold"
                android:text="Akşam vakti girince günün sorusunu bildir"
                android:textColor="@color/muted"
                android:textSize="14sp" />

            <TextView style="@style/SectionHead" android:text="Seviye seç ve başla" />

            <Button
                android:id="@+id/btnEasy"
                style="@style/Btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="60dp" />

            <Button
                android:id="@+id/btnMedium"
                style="@style/Btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:minHeight="60dp" />

            <Button
                android:id="@+id/btnHard"
                style="@style/Btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:minHeight="60dp" />

            <!-- Yanlış bilinen soru varsa görünür -->
            <Button
                android:id="@+id/btnReview"
                style="@style/Btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:minHeight="52dp"
                android:visibility="gone" />

            <!-- "Bu soruda hata var" diye işaretlenen soru varsa görünür -->
            <Button
                android:id="@+id/btnFlags"
                style="@style/Btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:minHeight="52dp"
                android:visibility="gone" />

            <TextView style="@style/SectionHead" android:text="Aile hedeflerimiz" />

            <LinearLayout
                android:id="@+id/goalList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card"
                android:orientation="vertical"
                android:padding="8dp" />

            <Button
                android:id="@+id/btnAddGoal"
                style="@style/Btn"
                android:layout_width="match_parent"
                android:layout_marginTop="10dp"
                android:text="+ Hedef ekle" />

            <!-- Yeni bir dönem için: ağaç tohuma döner (onay sorulur) -->
            <TextView
                android:id="@+id/btnResetTree"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="?android:attr/selectableItemBackground"
                android:padding="8dp"
                android:text="Ağacı sıfırla"
                android:textColor="@color/muted"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Sorular özgün olarak hazırlanmıştır. Kaynağı belirtilen sorularda ayet ya da hadis numarası verilmiştir. Fıkıh soruları Hanefi mezhebine göredir. Hatalı bulduğun soruyu cevaptan sonra işaretleyebilirsin."
                android:textColor="@color/muted"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- ================= OYUN ================= -->
        <LinearLayout
            android:id="@+id/playPane"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvProgress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/muted"
                    android:textSize="14sp" />

                <!-- Soruyu ve şıkları sesli okur -->
                <TextView
                    android:id="@+id/btnSpeak"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:contentDescription="Sesli oku"
                    android:padding="8dp"
                    android:text="🔊 Oku"
                    android:textColor="@color/gold"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/btnClose"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:padding="8dp"
                    android:text="Kapat ✕"
                    android:textColor="@color/gold"
                    android:textSize="15sp" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/bar"
                style="@android:style/Widget.Material.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:progressTint="@color/gold" />

            <!-- Sırayla oynanıyorsa: "Sıra: Zeynep" -->
            <TextView
                android:id="@+id/tvTurn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="@color/gold"
                android:textSize="18sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvQuestion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/card"
                android:lineSpacingExtra="4dp"
                android:padding="18dp"
                android:textColor="@color/text"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/options"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />

            <!-- accessibilityLiveRegion: TalkBack sonucu kendiliğinden okur -->
            <TextView
                android:id="@+id/tvInfo"
                android:accessibilityLiveRegion="polite"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/text"
                android:textSize="15sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnNext"
                style="@style/Btn"
                android:layout_width="match_parent"
                android:layout_marginTop="14dp"
                android:text="Sıradaki soru ›"
                android:visibility="gone" />

            <!-- Cevaptan sonra görünür: soruyu hatalı diye işaretle -->
            <TextView
                android:id="@+id/btnFlag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:background="?android:attr/selectableItemBackground"
                android:padding="10dp"
                android:text="⚑ Bu soruda hata var"
                android:textColor="@color/muted"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>
</ScrollView>
