    <!-- Konum izni açıklaması (LocationConsent) -->
    <string name="consent_title">Why is location access needed?</string>
    <string name="consent_message">Your location is used to:\n\n• Find your city and show its Diyanet prayer times\n• Update the times and the city/country name automatically when you travel\n• Calculate the Qibla direction\n\nOnly approximate location (city level) is requested. It is checked when you open the app and stays on your phone; the app has no server of its own.\n\nTo find the city name, the phone\'s own location service is asked first. If that fails, the coordinates are sent to OpenStreetMap without any identity information. The \"Mosques\" screen also sends the coordinates to OpenStreetMap to find mosques.\n\nYou can also choose your city manually without giving permission.</string>
    <string name="consent_yes">Use my location</string>
    <string name="consent_no">I\'ll choose manually</string>

